# Centinela — variables de entorno
#
# La app (6 páginas del dashboard) funciona SIN ninguna variable.
# Las variables sólo afectan la EXTRACCIÓN de contratos por IA.
# Sin proveedor configurado → "modo demo" con heurística local (no se rompe nada).

# ── Login con Google (opcional) ──────────────────────────────────────────
# Habilita el botón "Iniciar sesión con Google" en la pantalla de acceso.
# Se obtiene gratis en Google Cloud Console → APIs y servicios → Credenciales
# → "ID de cliente de OAuth" (tipo: Aplicación web). En "Orígenes de JavaScript
# autorizados" agregue http://localhost:3000 (y su dominio de producción).
# Sin esta variable, la app usa "modo demostración" (no se rompe nada).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Proveedor de IA ──────────────────────────────────────────────────────
# Opcional. Fuerza el proveedor: anthropic | openai | deepseek | gemini
# Si se omite, se usa el primero que tenga API key (orden: anthropic, openai, deepseek, gemini).
LLM_PROVIDER=

# Define SOLO la API key del proveedor que vayas a usar:
ANTHROPIC_API_KEY=        # Claude (Anthropic)
OPENAI_API_KEY=           # OpenAI (GPT)
DEEPSEEK_API_KEY=         # DeepSeek — la opción más costo-efectiva
GEMINI_API_KEY=           # Gemini (Google)

# ── Modelo (opcional) ────────────────────────────────────────────────────
# Sobrescribe el modelo del proveedor. Por defecto, el escalón más barato:
#   anthropic → claude-haiku-4-5
#   openai    → gpt-4o-mini
#   deepseek  → deepseek-chat
#   gemini    → gemini-2.0-flash
CENTINELA_EXTRACT_MODEL=

# ── Pruebas multimodales (Etapa 4 — Valoración de pruebas) ────────────────
# El análisis de imagen/audio/video usa Gemini de forma NATIVA (un solo modelo
# multimodal barato). Requiere GEMINI_API_KEY (arriba). Sin ella, el panel de
# pruebas muestra un análisis simulado y no se rompe.
# Modelo por defecto: gemini-2.0-flash-lite (el escalón más costo-efectivo).
CENTINELA_EVIDENCIA_MODEL=
