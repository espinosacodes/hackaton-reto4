# Centinela — variables de entorno
#
# La app (6 páginas del dashboard) funciona SIN ninguna variable.
# Las variables sólo afectan la EXTRACCIÓN de contratos por IA.
# Sin proveedor configurado → "modo demo" con heurística local (no se rompe nada).

# ── Proveedor de IA ──────────────────────────────────────────────────────
# Opcional. Fuerza el proveedor: anthropic | openai | deepseek | gemini
# Si se omite, se usa el primero que tenga API key (orden: anthropic, openai, deepseek, gemini).
LLM_PROVIDER=

# Define SOLO la API key del proveedor que vayas a usar:
ANTHROPIC_API_KEY=        # Claude (Anthropic)
OPENAI_API_KEY=           # OpenAI (GPT)
DEEPSEEK_API_KEY=         # DeepSeek — la opción más costo-efectiva
GEMINI_API_KEY=           # Gemini (Google)

# ── Modelo (opcional) ────────────────────────────────────────────────────
# Sobrescribe el modelo del proveedor. Por defecto, el escalón más barato:
#   anthropic → claude-haiku-4-5
#   openai    → gpt-4o-mini
#   deepseek  → deepseek-chat
#   gemini    → gemini-2.0-flash
CENTINELA_EXTRACT_MODEL=
