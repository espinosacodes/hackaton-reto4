# Centinela — variables de entorno

# Clave de la API de Anthropic (Claude). Sin ella, la extracción de contratos
# funciona en "modo demo" con una heurística local; con ella, usa el modelo de IA.
ANTHROPIC_API_KEY=

# Modelo para la extracción de cláusulas (tarea de alto volumen / bajo riesgo).
# Por defecto Haiku 4.5 (económico). Puede subirse a claude-sonnet-4-6 / claude-opus-4-8.
CENTINELA_EXTRACT_MODEL=claude-haiku-4-5
